{
  "name": "@moon-cx/sdk",
  "version": "2.0.1",
  "description": "SDK for the moon.cx DEX on TON: CPMM and CLMM pools, swaps, liquidity and positions",
  "homepage": "https://moon.cx/docs#sdk",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./math": {
      "types": "./dist/math/clmm.d.ts",
      "import": "./dist/math/clmm.js"
    },
    "./adapters/tonclient": {
      "types": "./dist/adapters/tonclient.d.ts",
      "import": "./dist/adapters/tonclient.js"
    },
    "./adapters/sender": {
      "types": "./dist/adapters/sender.d.ts",
      "import": "./dist/adapters/sender.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "protocol:extract": "node scripts/extract-protocol.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:dist": "npm run build && node --test \"test/dist.test.ts\""
  },
  "keywords": [
    "ton",
    "dex",
    "mooncx",
    "clmm",
    "cpmm",
    "defi"
  ],
  "peerDependencies": {
    "@ton/core": ">=0.60.0"
  },
  "devDependencies": {
    "@ton/core": "^0.62.1",
    "@ton/ton": "^15.4.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@ton-community/assets-sdk": "^0.0.5"
  }
}
