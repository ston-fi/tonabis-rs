  "helper": "TONCO ordered_wallets uses Option<TonAddress> and complete nullable-address cell hashes; whitelist_key takes &TonAddress. DeDust/STONks construction helpers use TonAddress-based inputs.",
  "policy": "Required identities use TonAddress/InternalAddress; nullable encoded identities use Option<TonAddress>/NullableAddress. Ordinary structured nullable fields derive FromTVMStack with NullableInternalAddress (Cell/Slice only, rejecting TVM NULL). Explicit optional nullable stacks retain Option<Option<TonAddress>> and protocol NULL behavior. Scalar normalization and Maybe/reference layouts are unchanged.",
  "manual_result_decoders": [
    "crates/moon/src/contracts/mempad/curve/method_results.rs",
    "crates/tonco/src/contracts/v2/router/method_results.rs"
  ],
  "manual_result_reason": "Manual result decoding remains for explicit NULL-returning address fields, dictionary roots (including NULL empty dictionaries), nested tuples or typed-reference layouts. Ordinary nullable fields use the released FromTVMStack field adapter.",
  "raw_field_exceptions": [
    "dedust::contracts::custom_wallet::v1::msgs: historical payload identities",
    "dedust::contracts::custom_wallet::v2::msgs: signed/opaque contexts and message forms",
    "dedust::contracts::custom_wallet::v2::storage: bare MsgAddressIntStd context records (no outer address tag)"
  ],
  "shared_adapters": [
    "core::adapters::nullable_internal_address::NullableInternalAddress",
    "core::adapters::maybe_address::MaybeAddress",
    "core::adapters::maybe_ref_address::MaybeRefAddress",
    "core::adapters::maybe_ref_nullable_address::MaybeRefNullableAddress"
  ],
  "dictionary_exception": "DeDust utils::DictValueInternalAddress implements ton-owned dictionary traits locally; core remains ton_core-only. Required dictionary values preserve internal zero instead of default TonAddress addr_none normalization.",
  "ordinary_nullable_result_policy": "FromTVMStack derive with NullableInternalAddress; accepts addr_none Cell/Slice as None and internal zero as Some(ZERO), rejects TVM NULL, checks exact structured arity."
}
